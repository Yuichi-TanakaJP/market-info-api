# R2 パブリックベース URL（末尾スラッシュなし）
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# 将来の認証用（未設定 = 認証なし）
MARKET_INFO_API_KEY=

# 優待株価Private R2（Cloud Runではsecretとして設定）
YUTAI_STOCK_PRICES_API_KEY=
YUTAI_STOCK_PRICES_PRIVATE_BUCKET=mini-tools-private
YUTAI_STOCK_PRICES_PRIVATE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
YUTAI_STOCK_PRICES_PRIVATE_ACCESS_KEY_ID=
YUTAI_STOCK_PRICES_PRIVATE_SECRET_ACCESS_KEY=
YUTAI_STOCK_PRICES_PRIVATE_REGION=auto

# Private credit history only; no public fallback. Provision after approval.
CREDIT_HISTORY_API_KEY=
CREDIT_HISTORY_PRIVATE_BUCKET=
CREDIT_HISTORY_PRIVATE_ENDPOINT=
CREDIT_HISTORY_PRIVATE_ACCESS_KEY_ID=
CREDIT_HISTORY_PRIVATE_SECRET_ACCESS_KEY=
CREDIT_HISTORY_PRIVATE_REGION=

# Private TDNET dividend source reads only. Unconfigured fails closed.
DIVIDEND_SOURCE_API_KEY=
DIVIDEND_SOURCE_PRIVATE_BUCKET=
DIVIDEND_SOURCE_PRIVATE_ENDPOINT=
DIVIDEND_SOURCE_PRIVATE_ACCESS_KEY_ID=
DIVIDEND_SOURCE_PRIVATE_SECRET_ACCESS_KEY=
DIVIDEND_SOURCE_PRIVATE_REGION=auto
